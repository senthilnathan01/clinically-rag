# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TOOLS_MODEL=gemini-3.1-pro-preview-customtools
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=together-healthcare
PINECONE_NAMESPACE=together-healthcare
# Optional: set when Pinecone shows you a host value and you want to skip describeIndex lookups
PINECONE_HOST=

# Optional experimental adapter scaffold
OPTIONAL_VECTOR_PROVIDER=pinecone
CHROMA_URL=
CHROMA_COLLECTION=together-healthcare

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_DEBUG_TRACES=false
