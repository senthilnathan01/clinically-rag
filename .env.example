# Vertex AI auth (choose one path; if both are set, GOOGLE_API_KEY wins)
# 1) Express mode / API key
GOOGLE_API_KEY=
# 2) Standard Vertex AI auth (ADC locally, or credentials JSON on deploy)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_CLOUD_CREDENTIALS_JSON=

# Gemini models on Vertex AI
GEMINI_MODEL=gemini-3.1-pro-preview
GEMINI_TOOLS_MODEL=gemini-3.1-pro-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Pinecone
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX_NAME=together-healthcare
PINECONE_NAMESPACE=together-healthcare
# Optional: set when Pinecone shows you a host value and you want to skip describeIndex lookups
PINECONE_HOST=

# Optional experimental adapter scaffold
OPTIONAL_VECTOR_PROVIDER=pinecone
CHROMA_URL=
CHROMA_COLLECTION=together-healthcare

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
ENABLE_DEBUG_TRACES=false
